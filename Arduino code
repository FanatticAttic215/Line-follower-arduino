#include <Servo.h>

Servo miServo;


const int sensorIZQ = 13;
const int sensorDER = 12;

const int in1 = 11;
const int in2 = 10;
const int in3 = 9;
const int in4 = 8;

const int trig = 7;
const int echo = 6;

const float obstaculo = 15.0;

void ServoMotorDeteccion(){
   for (int i = 45; i <= 135; i++) {
    miServo.write(i);
    delay(20);
    detectar();
  }
  for (int i = 135; i >= 45; i--) {
    miServo.write(i);
    delay(20);
    detectar();
  }
}


float detectar(){
  digitalWrite(trig, LOW);
  delayMicroseconds(2);
  digitalWrite(trig, HIGH);
  delayMicroseconds(10);      
  digitalWrite(trig, LOW);
  long tiempo = pulseIn(echo, HIGH);
  float distancia = tiempo * 0.0343 / 2;
  return distancia;
}

void adelante(){
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);

  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}

void derecha(){
  digitalWrite(in1, LOW);
  digitalWrite(in2, HIGH);

  digitalWrite(in3, LOW);
  digitalWrite(in4, LOW);
}

void izquierda(){
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);

  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}

void detenerse(){
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);
  
  digitalWrite(in3, LOW);
  digitalWrite(in4, LOW);
}

void esquivar(){
  detenerse();
  izquierda();
  delay(500);
  adelante();
  delay(250);
  derecha();
  delay(500);
  adelante();
  delay(250);
  derecha();
  delay(500);
  adelante();
  delay(250);
  izquierda();
}

void setup() {
  pinMode(sensorIZQ, INPUT);
  pinMode(sensorDER, INPUT);

  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);

  pinMode(trig, OUTPUT);
  pinMode(echo, INPUT);

  miServo.attach(5);
}

void loop() {
  int negraIZQ = digitalRead(sensorIZQ);
  int negraDER = digitalRead(sensorDER);
  
  detectar();
  
  //considerando que HIGH = linea negra
  if(negraIZQ == LOW && negraDER == LOW){
      if(detectar() > obstaculo){
        adelante();
      }
      else{
        ServoMotorDeteccion();
        esquivar();
      }
  }

  else if((negraIZQ == HIGH && negraDER == LOW) && (detectar() > obstaculo)){
    izquierda();
  }

  else if((negraIZQ == LOW && negraDER == HIGH) && (detectar() > obstaculo)){
    derecha();
  }

  else if(negraIZQ == HIGH && negraDER == HIGH){
    detenerse();
  }

}
